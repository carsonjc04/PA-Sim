# Copy to .env and fill in. .env is gitignored; never commit a real key.
# This file must contain example values only.

# Server-only. Never prefix with VITE_ — that would ship the key to the browser.
OPENAI_API_KEY=

# Voice conversation layer. Billed per second of session duration.
OPENAI_LIVE_MODEL=gpt-live-1

# Delegated reasoning backend. gpt-5.6-sol is the pricier, stronger option.
OPENAI_DELEGATE_MODEL=gpt-5.6-terra

# Leave blank to use the account default. Must be a supported GPT-Live voice.
OPENAI_VOICE=

# responses = OpenAI runs the delegated reasoning backend (default).
# client = this server would run it instead. Hidden case state stays here either way.
OPENAI_DELEGATION_MODE=responses

# Billed voice sessions allowed per client, per window.
LIVE_SESSION_RATE_LIMIT=5
LIVE_SESSION_RATE_WINDOW_MS=60000

ENABLE_AI_CASE_GENERATION=false
AI_CASE_MODE=bounded

# Server-enforced ceiling on a single voice session.
MAX_LIVE_SESSION_MINUTES=20

STORE_TRANSCRIPTS=false

# Estimate only, used for the developer usage panel. Never used in grading.
LIVE_VOICE_RATE_PER_MINUTE_USD=0.05

PORT=8787
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8787
