{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludeFiles": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/server/**", "pg"], "message": "Browser code must not import server or database modules." },
              { "group": ["**/domain/grading", "**/domain/schema", "**/server/content/**", "**/content/*.json"], "message": "Scenario content and grading are server-only; use the API client." }
            ]
          }
        ]
      }
    }
  ]
}
