  "objectives": [
    {
      "id": "acute-cough-sore-throat-assessment",
      "statement": "Perform a focused, safety-oriented history and exam for an adult with acute cough and sore throat.",
      "panceTasks": ["history-taking-physical-examination"]
    },
    {
      "id": "acute-respiratory-differential",
      "statement": "Distinguish an uncomplicated viral respiratory illness from streptococcal pharyngitis and pneumonia using history, vital signs and exam findings.",
      "panceTasks": ["formulating-the-most-likely-diagnosis"]
    },
    {
      "id": "acute-respiratory-diagnostic-stewardship",
      "statement": "Order testing and imaging for acute respiratory symptoms only when the result would change management.",
      "panceTasks": ["using-diagnostic-laboratory-studies"]
    },
    {
      "id": "uncomplicated-uri-management",
      "statement": "Manage an uncomplicated viral respiratory illness with supportive care, antibiotic stewardship, an appropriate setting of care and clear return precautions.",
      "panceTasks": ["clinical-intervention", "pharmaceutical-therapeutics", "health-maintenance-education-prevention"]
    },
    {
      "id": "acute-asthma-assessment",
      "statement": "Recognize an acute asthma exacerbation and quantify its severity objectively.",
      "panceTasks": ["history-taking-physical-examination", "formulating-the-most-likely-diagnosis"]
    },
    {
      "id": "acute-asthma-management",
      "statement": "Treat an acute asthma exacerbation without delay, reassess the response and base disposition on objective severity.",
      "panceTasks": ["clinical-intervention", "pharmaceutical-therapeutics"]
    },
    {
      "id": "suspected-acs-recognition",
      "statement": "Recognize suspected acute coronary syndrome in primary care and assess stability without delaying emergency activation.",
      "panceTasks": ["history-taking-physical-examination", "using-diagnostic-laboratory-studies", "formulating-the-most-likely-diagnosis"]
    },
    {
      "id": "suspected-acs-disposition",
      "statement": "Prioritize emergency activation and safe, monitored transfer over a routine outpatient workup for suspected acute coronary syndrome.",
      "panceTasks": ["clinical-intervention"]
    },
    {
      "id": "dysuria-assessment",
      "statement": "Distinguish acute uncomplicated cystitis from upper-tract infection and alternate causes using a focused history, exam and urine testing.",
      "panceTasks": ["history-taking-physical-examination", "using-diagnostic-laboratory-studies", "formulating-the-most-likely-diagnosis"]
    },
    {
      "id": "uncomplicated-cystitis-management",
      "statement": "Plan safe, individualized treatment of acute uncomplicated cystitis with return precautions and follow-up.",
      "panceTasks": ["pharmaceutical-therapeutics", "clinical-intervention"]
    },
    {
      "id": "new-diabetes-evaluation",
      "statement": "Recognize newly presenting type 2 diabetes, screen for hyperglycemic emergency and complete a focused baseline evaluation.",
      "panceTasks": ["history-taking-physical-examination", "using-diagnostic-laboratory-studies", "formulating-the-most-likely-diagnosis"]
    },
    {
      "id": "new-diabetes-management",
      "statement": "Start a timely, patient-centered management plan for newly recognized type 2 diabetes.",
      "panceTasks": ["clinical-intervention", "health-maintenance-education-prevention"]
    }
  ],
