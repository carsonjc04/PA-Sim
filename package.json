{
  "name": "pa-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "npm run content:check && tsc -b && vite build && tsx scripts/check-bundle.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:check": "tsx scripts/content/validate.ts --strict && tsx scripts/content/coverage.ts --check",
    "content:coverage": "tsx scripts/content/coverage.ts",
    "content:lock": "tsx scripts/content/lock.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx server/db/cli.ts",
    "review:upgrade": "tsx scripts/review/upgrade.ts",
    "test:live": "RUN_OPENAI_LIVE_SMOKE=1 vitest run server/openai/live-smoke.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "openai": "^7.20.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "5.4.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
